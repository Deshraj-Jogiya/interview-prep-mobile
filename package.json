{
  "name": "interview-prep-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "@testing-library/react-native": "^12.9.0",
    "react-test-renderer": "19.2.3",
    "@types/jest": "^29.5.14"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
